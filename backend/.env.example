NODE_ENV=development
PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=http://localhost:5173
# Production (set in Render dashboard):
# FRONTEND_URL=https://scalaxlab.in
# ALLOWED_ORIGINS=https://www.scalaxlab.in

# ── Email Provider ────────────────────────────────────────────────────────────
# Resend (domain scalaxlab.in is already verified — use @scalaxlab.in as sender)
RESEND_API_KEY=re_xxxxxxxxx

# "From" address — MUST be an address on the verified domain @scalaxlab.in
# Do NOT use onboarding@resend.dev or a Gmail address here.
EMAIL_FROM=Scalax Labs <hrteam@scalaxlab.in>

# Gmail inbox that receives contact form notifications from customers
CONTACT_RECEIVER_EMAIL=yourbusiness@gmail.com

# ── Optional: SendGrid (alternative to Resend) ───────────────────────────────
# SENDGRID_API_KEY=

# ── Optional: SMTP (not recommended on Render — port blocking applies) ────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── Other ─────────────────────────────────────────────────────────────────────
SEND_LOGIN_NOTIFICATION_EMAILS=false
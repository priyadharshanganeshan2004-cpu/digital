NODE_ENV=development
PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=http://localhost:5173

# ── Email Provider (pick ONE) ────────────────────────────────────────────────
# Option A — SendGrid (recommended, free 100 emails/day, no domain needed)
SENDGRID_API_KEY=

# Option B — Resend (requires verified domain for non-owner recipients)
RESEND_API_KEY=

# Option C — SMTP (not recommended on Render — port blocking applies)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Email Addresses ──────────────────────────────────────────────────────────
# The "from" address — must be verified as Single Sender in SendGrid
EMAIL_FROM=Scalax Labs <priyadharshanganeshan2004@gmail.com>

# Gmail inbox that receives contact form notifications
# Change this to your Gmail address
CONTACT_RECEIVER_EMAIL=priyadharshanganeshan2004@gmail.com

# ── Other ────────────────────────────────────────────────────────────────────
SEND_LOGIN_NOTIFICATION_EMAILS=false